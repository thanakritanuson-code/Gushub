local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local gui = script.Parent

-- UI References
local openCloseBtn = gui:WaitForChild("OpenCloseBtn")
local menuFrame = gui:WaitForChild("MenuFrame")
local headerLabel = menuFrame:WaitForChild("HeaderLabel")
local closeMenuBtn = menuFrame:WaitForChild("CloseMenuBtn")
local toggleQTEBtn = menuFrame:WaitForChild("ToggleQTEBtn")

local qteFrame = gui:WaitForChild("QTEFrame")
local keyDisplayLabel = qteFrame:WaitForChild("KeyDisplayLabel")
local timerBar = qteFrame:WaitForChild("TimerBar")
local statusText = qteFrame:WaitForChild("StatusText")

-- สถานะระบบ
local isScriptActive = false
local isQTEPlaying = false
local currentRequiredKey = nil
local qteSuccess = false
local qteTimeLimit = 1.2 -- เวลาในการกด (วินาที)

-- รายการปุ่มสุ่มแบบ Fisch (E, R, F, Q, Space)
local possibleKeys = {
	Enum.KeyCode.E,
	Enum.KeyCode.R,
	Enum.KeyCode.F,
	Enum.KeyCode.Q,
	Enum.KeyCode.Space
}

----------------------------------------------------
-- 1. ระบบ เปิด/ปิด และ ลากเมนู (Draggable Menu)
----------------------------------------------------
openCloseBtn.MouseButton1Click:Connect(function()
	menuFrame.Visible = not menuFrame.Visible
end)

closeMenuBtn.MouseButton1Click:Connect(function()
	menuFrame.Visible = false
end)

-- ระบบลากเมนู (Drag System)
local dragging, dragStart, startPos
headerLabel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = menuFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		menuFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

----------------------------------------------------
-- 2. ระบบ Toggle เปิด/ปิด การทำงาน
----------------------------------------------------
toggleQTEBtn.MouseButton1Click:Connect(function()
	isScriptActive = not isScriptActive
	if isScriptActive then
		toggleQTEBtn.Text = "Auto QTE: ON"
		toggleQTEBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
	else
		toggleQTEBtn.Text = "Auto QTE: OFF"
		toggleQTEBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
		qteFrame.Visible = false
	end
end)

----------------------------------------------------
-- 3. มินิเกม Fisch QTE (สุ่มปุ่มกด)
----------------------------------------------------
local function startFischQTE()
	if isQTEPlaying or not isScriptActive then return end
	isQTEPlaying = true
	qteSuccess = false
	
	-- สุ่มปุ่ม
	currentRequiredKey = possibleKeys[math.random(1, #possibleKeys)]
	keyDisplayLabel.Text = currentRequiredKey.Name
	statusText.Text = "PRESS!"
	
	-- แสดง QTE UI และ รีเซ็ตแถบเวลา
	qteFrame.Visible = true
	timerBar.Size = UDim2.new(1, 0, 1, 0)
	
	-- หลอดเวลาลดลง (Tween)
	local tweenInfo = TweenInfo.new(qteTimeLimit, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(timerBar, tweenInfo, {Size = UDim2.new(0, 0, 1, 0)})
	tween:Play()
	
	-- รอหมดเวลา
	task.wait(qteTimeLimit)
	
	if not qteSuccess and isQTEPlaying then
		statusText.Text = "FAILED!"
		task.wait(0.5)
		qteFrame.Visible = false
		isQTEPlaying = false
	end
end

----------------------------------------------------
-- 4. ตรวจจับการกดปุ่มจากผู้เล่น
----------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not isQTEPlaying or qteSuccess then return end
	
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == currentRequiredKey then
			-- กดถูกต้องตามจังหวะ
			qteSuccess = true
			statusText.Text = "PERFECT!"
			print("Fisch QTE Success!")
			
			task.wait(0.4)
			qteFrame.Visible = false
			isQTEPlaying = false
			
			-- TODO: ใส่โค้ดส่งสัญญาณไป Server เพื่อดึงปลาขึ้น หรือสั่งเบ็ดตกปลาที่นี่
		else
			-- กดผิดปุ่ม
			qteSuccess = false
			statusText.Text = "WRONG KEY!"
			
			task.wait(0.4)
			qteFrame.Visible = false
			isQTEPlaying = false
		end
	end
end)

----------------------------------------------------
-- ลูปจำลองการเกิด QTE (จะทำงานเฉพาะตอนเปิดสวิตช์ ON)
----------------------------------------------------
task.spawn(function()
	while true do
		task.wait(4) -- สุ่มมินิเกมขึ้นมาทุกๆ 4 วินาที
		if isScriptActive and not isQTEPlaying then
			startFischQTE()
		end
	end
end)
